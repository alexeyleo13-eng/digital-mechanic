# Внешние сервисы (заглушки заказчика; для боевого режима подставить рабочие URL)
MOCK_ML_URL=http://127.0.0.1:8001
MOCK_TOIR_URL=http://127.0.0.1:8002

# LLM. Без ключа приложение работает в демо-режиме без LLM (ответы — найденные фрагменты руководства).
# Вариант 1: Gemini (Google AI Studio, ключ: aistudio.google.com → Get API key)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
# reasoning_effort: low | medium | high (пусто — по умолчанию модели)
LLM_EFFORT=medium

# Вариант 2: Claude (официальный SDK Anthropic)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_API_KEY=
# LLM_EFFORT=medium
# Серверный fallback при отказе модели (beta). 0 — выключить.
# LLM_FALLBACKS=1

# Вариант 3: любой OpenAI-совместимый endpoint (OpenRouter, YandexGPT, GigaChat-прокси, Ollama)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-opus-5.5
# LLM_API_KEY=
